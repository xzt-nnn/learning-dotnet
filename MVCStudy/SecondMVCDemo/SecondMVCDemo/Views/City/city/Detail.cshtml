@model SecondMVCDemo.Models.City
@{
    Layout = null;
    ViewBag.Title = "城市详情";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft YaHei", sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
            background-color: #f5f7fa;
        }

        .card {
            width: 100%;
            max-width: 520px;
            padding: 32px;
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        }

        .card h2 {
            margin-bottom: 22px;
            font-size: 22px;
            color: #2d3748;
            text-align: center;
        }

        .detail-row {
            display: flex;
            padding: 12px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .detail-row:last-of-type {
            border-bottom: none;
        }

        .detail-label {
            width: 96px;
            flex-shrink: 0;
            color: #718096;
            font-size: 14px;
        }

        .detail-value {
            color: #2d3748;
            font-size: 14px;
            word-break: break-all;
        }

        .empty {
            padding: 30px 0;
            color: #c53030;
            font-size: 15px;
            text-align: center;
        }

        .actions {
            margin-top: 24px;
            display: flex;
            gap: 12px;
        }

        .btn {
            flex: 1;
            padding: 11px 0;
            font-size: 15px;
            text-align: center;
            text-decoration: none;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .btn-back {
            color: #4a5568;
            background-color: #edf2f7;
        }

        .btn-back:hover {
            background-color: #e2e8f0;
        }

        .btn-list {
            color: #ffffff;
            background-color: #4a5568;
        }

        .btn-list:hover {
            background-color: #2d3748;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>城市详情</h2>

        @if (Model == null)
        {
            <div class="empty">未找到该城市的数据</div>
        }
        else
        {
            <div class="detail-row">
                <span class="detail-label">Id</span>
                <span class="detail-value">@Model.Id</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">省份</span>
                <span class="detail-value">@Model.Province</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">城市名称</span>
                <span class="detail-value">@Model.Name</span>
            </div>
        }

        <div class="actions">
            <a class="btn btn-back" href="javascript:history.back()">返回</a>
            <a class="btn btn-list" href="@Url.Action("CityList", "City")">回到列表</a>
        </div>
    </div>
</body>
</html>
