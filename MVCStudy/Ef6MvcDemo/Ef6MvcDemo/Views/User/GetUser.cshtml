@model Ef6MvcDemo.Models.User

@{
    ViewBag.Title = "GetUser";
}

<h2>GetUser</h2>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

<div>
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(model => model.Id)</dt>
        <dd>@Html.DisplayFor(model => model.Id)</dd>

        <dt>@Html.DisplayNameFor(model => model.UserName)</dt>
        <dd>@Html.DisplayFor(model => model.UserName)</dd>

        <dt>@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd>@Html.DisplayFor(model => model.Phone)</dd>

        <dt>@Html.DisplayNameFor(model => model.CreateTime)</dt>
        <dd>@Html.DisplayFor(model => model.CreateTime)</dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Back to List", "Index")
</p>
@if (!string.IsNullOrEmpty(Model.AvatarPath))
{
    <img src="@Model.AvatarPath" alt="头像" style="width:120px;height:120px;object-fit:cover;" />
}
else
{
    <span>暂无头像</span>
}

@using (Html.BeginForm("UploadAvatar", "User", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <input type="file" name="file" accept="image/*" />
    <button type="submit" class="btn btn-primary">上传头像</button>
}