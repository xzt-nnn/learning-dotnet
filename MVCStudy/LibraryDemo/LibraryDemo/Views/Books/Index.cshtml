@using LibraryDemo.ViewModels
@model BookIndexVm

@{
    ViewBag.Title = "图书列表";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">图书列表</h2>
    @Html.ActionLink("新增图书", "Create", null, new { @class = "btn btn-success" })
</div>

@if (TempData["Success"] != null)
{
    <div id="successAlert" class="alert alert-success fade show">@TempData["Success"]</div>

    <script>
        // 2 秒后淡出并移除提示
        setTimeout(function () {
            var alertEl = document.getElementById('successAlert');
            if (!alertEl) return;
            alertEl.classList.remove('show');   // 触发 Bootstrap 的淡出动画
            setTimeout(function () { alertEl.remove(); }, 200);
        }, 2000);
    </script>
}

@using (Html.BeginForm("Index", "Books", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-12 col-md-4">
        @Html.TextBoxFor(m => m.Keyword, new { @class = "form-control", placeholder = "书名 / 作者 / ISBN" })
    </div>
    <div class="col-12 col-md-3">
        @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "全部分类", new { @class = "form-select" })
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-primary">搜索</button>
        @Html.ActionLink("重置", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

<p class="text-muted">共 @Model.TotalCount 条记录</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ISBN</th>
            <th>书名</th>
            <th>作者</th>
            <th>分类</th>
            <th>出版社</th>
            <th>可借 / 总量</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">没有找到符合条件的图书</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Isbn</td>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.CategoryName</td>
                    <td>@item.Publisher</td>
                    <td>@item.AvailableCopies / @item.TotalCopies</td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);

    <nav aria-label="图书分页">
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                @Html.ActionLink("上一页", "Index",
                    new { keyword = Model.Keyword, categoryId = Model.CategoryId, page = Model.Page - 1 },
                    new { @class = "page-link", tabindex = "-1" })
            </li>

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    @Html.ActionLink(i.ToString(), "Index",
                        new { keyword = Model.Keyword, categoryId = Model.CategoryId, page = i },
                        new { @class = "page-link" })
                </li>
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                @Html.ActionLink("下一页", "Index",
                    new { keyword = Model.Keyword, categoryId = Model.CategoryId, page = Model.Page + 1 },
                    new { @class = "page-link", tabindex = "-1" })
            </li>
        </ul>
    </nav>
}