@using LibraryDemo.Models
@model IList<BorrowRecord>

@{
    ViewBag.Title = "借阅记录";
    bool onlyUnreturned = ViewBag.OnlyUnreturned ?? true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">借阅记录</h2>
    @if (onlyUnreturned)
    {
        @Html.ActionLink("查看全部", "Index", new { onlyUnreturned = false }, new { @class = "btn btn-outline-secondary" })
    }
    else
    {
        @Html.ActionLink("只看未还", "Index", new { onlyUnreturned = true }, new { @class = "btn btn-outline-secondary" })
    }
</div>

@if (TempData["Success"] != null)
{
    <div id="okAlert" class="alert alert-success fade show">@TempData["Success"]</div>
    <script>
        setTimeout(function () {
            var el = document.getElementById('okAlert');
            if (!el) return;
            el.classList.remove('show');
            setTimeout(function () { el.remove(); }, 200);
        }, 2000);
    </script>
}

@if (TempData["Error"] != null)
{
    <div id="errAlert" class="alert alert-danger fade show">@TempData["Error"]</div>
    <script>
        setTimeout(function () {
            var el = document.getElementById('errAlert');
            if (!el) return;
            el.classList.remove('show');
            setTimeout(function () { el.remove(); }, 200);
        }, 2000);
    </script>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>书名</th>
            <th>读者</th>
            <th>借出时间</th>
            <th>应还时间</th>
            <th>归还时间</th>
            <th>状态</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">暂无借阅记录</td></tr>
        }

        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.Book != null ? r.Book.Title : "-")</td>
                <td>@(r.Reader != null ? r.Reader.CardNo + " - " + r.Reader.Name : "-")</td>
                <td>@r.BorrowDate.ToString("yyyy-MM-dd")</td>
                <td class="@(r.IsOverdue ? "text-danger fw-bold" : "")">@r.DueDate.ToString("yyyy-MM-dd")</td>
                <td>@(r.ReturnDate.HasValue ? r.ReturnDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                <td>
                    <span class="badge @(r.Status != 0 ? "bg-secondary" : (r.IsOverdue ? "bg-danger" : "bg-primary"))">
                        @(r.Status != 0 ? "已归还" : (r.IsOverdue ? "逾期未还" : "借出中"))
                    </span>
                </td>
                <td>
                    @if (r.Status == 0)
                    {
                        <form method="post" action="@Url.Action("Return", "Borrow", new { id = r.Id })"
                              class="d-inline" onsubmit="return confirm('确认归还这本书吗？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success">归还</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
