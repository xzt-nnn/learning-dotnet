
@{
    ViewBag.Title = "登录页面";
}

<h2>登录</h2>
@if(ViewBag.Tip!=null)
            {
                <p style="color:red">@ViewBag.Tip</p>
            }

<form action="@Url.Action("LoginSubmit")" method="post">
    <div>账号：<input type="text" name="userName"/></div>
    <div>密码：<input type="password" name="password"/></div>
    <button type="submit">提交登录</button>
</form>
