@{
    ViewBag.Title = "首页";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>测试 ViewBag / ViewData 跳转丢失演示</h2>

<p>ViewBag.Msg：@ViewBag.Msg</p>
<p>ViewData["Msg2"]：@ViewData["Msg2"]</p>
